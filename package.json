{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "npx tsx tests/GoldenScenarios.test.ts && npx tsx tests/domain/RelationshipAndMemory.test.ts && npx tsx tests/integration/RelationshipTargetIntegration.test.ts && npx tsx tests/integration/RelationshipEngineIntegration.test.ts && npx tsx tests/domain/NpcAi.test.ts && npx tsx tests/integration/NpcAiEngineIntegration.test.ts && npx tsx src/tools/ReplayValidator.ts",
    "stress": "npx tsx src/tools/StressTestRunner.ts",
    "stress:short": "npx tsx src/tools/StressTestRunner.ts --ticks 10000",
    "stress:medium": "npx tsx src/tools/StressTestRunner.ts --ticks 50000",
    "stress:long": "npx tsx src/tools/StressTestRunner.ts --ticks 100000",
    "replay:validate": "npx tsx src/tools/ReplayValidator.ts",
    "snapshot:run": "npx tsx src/tools/StressTestRunner.ts --ticks 100000"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "pdf-parse": "^2.4.5",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
