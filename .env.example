# HUGGINGFACE_API_KEY: Required for Hugging Face Serverless Inference (Free tier).
HUGGINGFACE_API_KEY=""

# OPENCODE_API_KEY: Required for OpenCode Zen models (Free tier).
OPENCODE_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

